# Development Dockerfile with hot reload
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

# Fix for npm optional dependencies bug on ARM64
# Use ci with clean slate, but first ensure package-lock.json doesn't exist
RUN rm -f package-lock.json && \
    npm cache clean --force && \
    npm install --legacy-peer-deps

COPY . .

# Expose port for Angular dev server
EXPOSE 4200

# Run Angular dev server with polling (needed for Docker)
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]

